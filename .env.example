# ─── Profil & serveur ─────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ─── Base de données ──────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/gesper
DB_NAME=gesper
DB_USERNAME=gesper
DB_PASSWORD=gesper
DB_PORT=5432

# ─── Sécurité JWT ─────────────────────────────────────────────────
# IMPORTANT : générer en prod avec : openssl rand -base64 64
JWT_SECRET=Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24tdGhpcy1pcy1hLXNlY3JldC1rZXktZm9yLWp3dC1hdC1sZWFzdC0yNTYtYml0cw==
# Durée du access token en millisecondes (15 min)
JWT_ACCESS_EXPIRATION=900000
# Durée du refresh token en millisecondes (7 jours)
JWT_REFRESH_EXPIRATION=604800000

# ─── OAuth2 Google ────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
# Redirect URI à autoriser sur Google Cloud :
#   http://localhost:8080/api/v1/oauth2/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URIs autorisées pour la redirection vers le frontend après login OAuth2
OAUTH2_REDIRECT_URIS=http://localhost:3000/oauth2/redirect,http://localhost:5173/oauth2/redirect

# ─── CORS ─────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200

# ─── Mail (Gmail SMTP ou Mailhog) ─────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@gesper.com
MAIL_FROM_NAME=GesPer
# Destinataire des emails de demande de création admin
MAIL_ADMIN_RECIPIENT=admin@gesper.com
